# Porta HTTP do microserviço (8080 padrão original; use 8081 para integração com Plataforma da Mulher)
PORT=8080

# Porta e Host do servidor gRPC (padrão seguro localhost: 127.0.0.1:50051)
GRPC_PORT=50051
GRPC_HOST=127.0.0.1

# Chave secreta compartilhada para autenticação serviço-a-serviço (mínimo 16 caracteres)
# Nunca preencha segredos reais neste arquivo de exemplo.
SERVICE_KEY=

# Obrigatoriedade de autenticação nos endpoints sensíveis (/alertas)
# Quando 'true', o servidor falha ao iniciar se SERVICE_KEY estiver vazia ou com menos de 16 caracteres.
EXIGIR_AUTENTICACAO=false

# Banco SQLite próprio (arquivo criado automaticamente na primeira execução com migração segura)
DATABASE_URL=file:botao_panico.db

# API externa de geocodificação reversa (Nominatim/OpenStreetMap).
# Deixe vazio (EXTERNAL_API_URL=) para desativar a geocodificação.
EXTERNAL_API_URL=https://nominatim.openstreetmap.org
EXTERNAL_API_TIMEOUT=3s
# Identificação exigida pela política de uso do Nominatim público
EXTERNAL_API_USER_AGENT=botao-panico-plataforma-mulher/1.0 (trabalho academico CIT7219)

# Prazo máximo para concluir o envio das notificações de um alerta
NOTIFICATION_TIMEOUT=5s

# ==============================================================================
# Mensageria NATS JetStream e Transactional Outbox (Semana 12 CIT7219)
# ==============================================================================
# Habilita o processamento assíncrono via fila persistente e outbox no SQLite
FILAS_ATIVAS=true

# URL de conexão com NATS broker externo (ex.: nats://127.0.0.1:4222)
# Deixe vazio para inicializar o servidor NATS JetStream embutido restrito a 127.0.0.1
NATS_URL=

# Nome do Stream persistente e Subject de roteamento
NATS_STREAM=ALERTAS
NATS_SUBJECT=alertas.notificar

# Identificador do consumidor durável de notificações
NATS_CONSUMER=worker-notificacoes

# Diretório para armazenamento dos logs de mensagem do JetStream no disco
NATS_STORE_DIR=data/jetstream

# Timeout de encerramento gracioso dos workers
WORKER_SHUTDOWN_TIMEOUT=5s
