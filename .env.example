# ==============================================================================
# Variáveis de Ambiente — Botão de Pânico (Go + RabbitMQ + SQLite)
# Modelo seguro para desenvolvimento local e demonstração acadêmica
# ==============================================================================

# Portas de Serviço
PORT=8081
GRPC_PORT=50051
GRPC_HOST=127.0.0.1

# Banco de Dados SQLite Local
DATABASE_URL=file:botao_panico.db

# Autenticação Serviço-a-Serviço (S2S)
# Obrigatória em ambiente integrado com a Plataforma da Mulher
EXIGIR_AUTENTICACAO=false
SERVICE_KEY=sua-chave-secreta-minimo-16-caracteres

# Geocodificação Externa (Nominatim / OpenStreetMap)
EXTERNAL_API_URL=https://nominatim.openstreetmap.org
EXTERNAL_API_TIMEOUT=3s
EXTERNAL_API_USER_AGENT=botao-panico-plataforma-mulher/1.0 (trabalho academico CIT7219)
NOTIFICATION_TIMEOUT=5s
WORKER_SHUTDOWN_TIMEOUT=5s

# ==============================================================================
# Mensageria RabbitMQ AMQP 0-9-1 (Semana 13 CIT7219)
# ==============================================================================
FILAS_ATIVAS=true
AMQP_URL=amqp://guest:guest@127.0.0.1:5672/
RABBITMQ_EXCHANGE=panico.eventos
RABBITMQ_DLX=panico.eventos.dlx
RABBITMQ_QUEUE_NOTIFICACOES=panico.alertas.notificacoes
RABBITMQ_ROUTING_KEY_NOTIFICACOES=alerta.criado
RABBITMQ_QUEUE_AUDITORIA=panico.alertas.auditoria
RABBITMQ_ROUTING_KEY_AUDITORIA=#
RABBITMQ_QUEUE_DLQ=panico.alertas.dlq

# ==============================================================================
# E-mail Demonstrativo Acadêmico (FASE 6 — Desativado por padrão)
# Restrito EXCLUSIVAMENTE ao envio para: plataformadamulheroficial@gmail.com
# ==============================================================================
EMAIL_DEMO_ATIVO=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
